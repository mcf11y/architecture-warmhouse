@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Диаграмма компонентов — Notification Service

Container_Boundary(notification_service, "Notification Service") {

    Component(api_controller, "API Controller", "Go / Gin", "Обрабатывает HTTP-запросы: настройки уведомлений, история отправок.")
    Component(event_consumer, "Event Consumer", "Go", "Подписан на события scenario.triggered и device.alert из Message Broker.")
    Component(notification_manager, "Notification Manager", "Go", "Определяет канал доставки и формирует сообщение по шаблону.")
    Component(sender, "Notification Sender", "Go", "Отправка уведомлений через конкретные каналы: push, email, SMS.")
    Component(notification_repo, "Notification Repository", "Go / pgx", "Абстракция доступа к данным. Шаблоны, настройки, история уведомлений.")
}

ContainerDb(notification_db, "Notification DB", "PostgreSQL", "Шаблоны, настройки каналов, история.")
ContainerQueue(message_broker, "Message Broker", "Kafka", "Асинхронный обмен событиями.")
Container(api_gateway, "API Gateway", "Nginx / Kong", "Маршрутизация запросов.")
System_Ext(ext_channels, "Внешние каналы", "SMTP-сервер, Push-сервис, SMS-шлюз.")

Rel(api_controller, notification_repo, "Настройки / история")
Rel(event_consumer, notification_manager, "Передаёт событие")
Rel(notification_manager, notification_repo, "Загружает шаблон и настройки")
Rel(notification_manager, sender, "Отправка сообщения")

Rel(api_gateway, api_controller, "REST-запросы", "HTTP")
Rel(message_broker, event_consumer, "События scenario.triggered, device.alert", "async")
Rel(sender, ext_channels, "Доставка уведомлений", "SMTP/HTTP")
Rel(notification_repo, notification_db, "SQL-запросы", "SQL/TCP")

@enduml
